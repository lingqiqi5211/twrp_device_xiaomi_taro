on early-init
    # TWRP mounts the vendor image over the ramdisk's own /vendor all through
    # startup, so libqtikeymint.so resolves to either copy. The vendor image's
    # copy needs a keymint V1 library no recovery ships, which kills keymint-qti
    # at link time, so bind the ramdisk's directory where nothing can shadow it
    # and let the security services search that first.
    mkdir /vendor_lib64 0755 root root
    mount none /vendor/lib64 /vendor_lib64 bind

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on init
    # TWRP skips a requested module whose name is already in /proc/modules. The
    # vendor_boot touch driver loads on a kernel it was not built for and binds
    # nothing, so unload it here, before recovery loads the vendor_dlkm copy.
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/beforemodules.sh

    # qseecomd needs the UFS by-name links before its RPMB listener starts.
    # Starting it only after the link exists also makes the security HALs
    # available before recovery attempts metadata decryption.
    wait /dev/block/platform/soc/${ro.boot.bootdevice} 10
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd

on fs
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion

on property:twrp.modules.loaded=true
    # Mount firmware before starting the ADSP battery path.
    mkdir /firmware 0755 root root
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    # The PMIC battery node appeared 3.3 seconds later on the tested kernel.
    # Waiting here blocks init itself, including keystore control requests, so
    # move that wait into a one-shot helper service.
    start twrp-wait-for-battery

on property:twrp.battery.ready=true
    # Keep firmware mounted until the ADSP has created the battery supply.
    # The helper also retries the firmware unmount after publishing readiness,
    # because the kernel can retain a firmware file briefly after ADSP starts.
    start health-hal-2-1
    start batterysecret

service twrp-wait-for-battery /system/bin/sh /system/bin/waitforbattery.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
