service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi@1.0-service
    interface android.hardware.wifi@1.0::IWifi default
    interface android.hardware.wifi@1.1::IWifi default
    interface android.hardware.wifi@1.2::IWifi default
    interface android.hardware.wifi@1.3::IWifi default
    interface android.hardware.wifi@1.4::IWifi default
    interface android.hardware.wifi@1.5::IWifi default
    class hal
    capabilities NET_ADMIN NET_RAW SYS_MODULE
    user root
    group root wifi inet gps
    seclabel u:r:recovery:s0
    disabled
    oneshot

# The recovery UI starts and stops this by name.
service wpa_supplicant /system/bin/taro-wifi-control run
    class main
    user root
    group root wifi inet net_raw net_admin
    seclabel u:r:recovery:s0
    disabled
    oneshot

# ctl.stop leaves the interface up and the old address published.
on property:init.svc.wpa_supplicant=stopped
    start taro-wifi-cleanup

service taro-wifi-cleanup /system/bin/taro-wifi-control stop
    user root
    group root wifi inet net_admin
    seclabel u:r:recovery:s0
    disabled
    oneshot
