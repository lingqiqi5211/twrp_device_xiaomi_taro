# ADB
ro.adb.secure=0
# adbd listens on tcp:5555 alongside USB from startup, so it becomes
# reachable as soon as the WLAN interface has an address.
service.adb.tcp.port=5555
ro.boot.dynamic_partitions=true

# Battery / QTI HAL selection
ro.charger.enable_suspend=1
ro.hardware.bootctrl=qti

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Dynamic partitions
ro.dynamic.full_size=9663676416

# USB
vendor.usb.configfs=1
vendor.usb.use_ffs_mtp=1
vendor.usb.rps_mask=0
